{
  "name": "synthetic-dream-machine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:fresh": "pnpm -r build && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "dev": "concurrently -n node,vite -c magenta,cyan \"pnpm --filter @lararium/node dev\" \"pnpm --filter @lararium/app dev\"",
    "test:unit": "pnpm -r test",
    "test:sigil-alignment": "pnpm --filter @lararium/tw5 test:sigil-alignment",
    "test:e2e": "pnpm --filter @lares/harness test:e2e",
    "test:e2e:live": "pnpm --filter @lares/harness test:live"
  },
  "devDependencies": {
    "@lares/cli": "workspace:*",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "playwright": "^1.59.1",
    "playwright-mcp-wsl": "^1.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "vite": "^8.0.10"
    }
  }
}
