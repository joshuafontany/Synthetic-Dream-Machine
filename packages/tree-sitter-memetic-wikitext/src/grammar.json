{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "memetic_wikitext",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_block"
      }
    },
    "_block": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "ahu_block"
        },
        {
          "type": "SYMBOL",
          "name": "sigil"
        },
        {
          "type": "SYMBOL",
          "name": "fenced_block"
        },
        {
          "type": "SYMBOL",
          "name": "heading"
        },
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "blank_line"
        },
        {
          "type": "SYMBOL",
          "name": "text_line"
        }
      ]
    },
    "ahu_block": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "open",
            "content": {
              "type": "SYMBOL",
              "name": "sigil"
            }
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "_block"
            }
          },
          {
            "type": "FIELD",
            "name": "close",
            "content": {
              "type": "SYMBOL",
              "name": "sigil_close"
            }
          }
        ]
      }
    },
    "sigil": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<<~"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "body",
              "content": {
                "type": "SYMBOL",
                "name": "sigil_body"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ">>"
        }
      ]
    },
    "sigil_close": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<<~/"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "body",
              "content": {
                "type": "SYMBOL",
                "name": "sigil_body"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ">>"
        }
      ]
    },
    "sigil_body": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "([^>\\n]|>[^>])+"
        }
      }
    },
    "fenced_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "info",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "TOKEN",
              "content": {
                "type": "PATTERN",
                "value": "```[^\\n]*\\n"
              }
            },
            "named": true,
            "value": "fence_open"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "FIELD",
            "name": "line",
            "content": {
              "type": "ALIAS",
              "content": {
                "type": "TOKEN",
                "content": {
                  "type": "PATTERN",
                  "value": "[^`\\n][^\\n]*\\n|`[^`][^\\n]*\\n|\\n"
                }
              },
              "named": true,
              "value": "fence_line"
            }
          }
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "TOKEN",
            "content": {
              "type": "PATTERN",
              "value": "```[ \\t]*\\n?"
            }
          },
          "named": true,
          "value": "fence_close"
        }
      ]
    },
    "heading": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "#+[ \\t][^\\n]*\\n?"
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "<!--([^-]|-[^-]|--[^>])*-->\\n?"
      }
    },
    "blank_line": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[ \\t]*\\n"
      }
    },
    "text_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\n]+\\n?"
        }
      }
    }
  },
  "extras": [],
  "conflicts": [
    [
      "_block",
      "ahu_block"
    ]
  ],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}