{
  "name": "@lararium/mempalace",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only integration layer: consumes the pinned mempalace sidecar (read-only) and harvests a never-federated session-memory bearing index.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./xdg-base": {
      "import": "./dist/xdg-base.js",
      "types": "./dist/xdg-base.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "node ../../tools/clean-output.mjs dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@lararium/mesh": "workspace:*"
  }
}
