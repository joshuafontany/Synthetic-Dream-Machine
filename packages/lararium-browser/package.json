{
  "name": "@lararium/browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "prebuild": "node ../../tools/clean-output.mjs dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@automerge/automerge": "^3.2.6",
    "@automerge/automerge-repo": "^2.5.5",
    "@automerge/automerge-repo-network-messagechannel": "^2.5.1",
    "@automerge/automerge-repo-storage-indexeddb": "^2.5.6",
    "@lararium/mesh": "workspace:*",
    "@lararium/tw5": "workspace:*"
  },
  "devDependencies": {
    "@vitest/browser": "^3.2.0",
    "tsx": "^4.19.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^3.2.0"
  }
}
