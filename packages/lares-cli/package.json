{
  "name": "@lares/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Lares operator CLI — lares init, lares act (Residency Model ACTION verbs), lares wiki, lares bag, lares heleuma, … One entry point for every operator-facing ceremony.",
  "type": "module",
  "bin": {
    "lares": "./bin/lares.mjs"
  },
  "scripts": {
    "prebuild": "node ../../tools/clean-output.mjs dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/bin/lares.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@automerge/automerge-repo": "2.6.0-alpha.2",
    "@automerge/automerge-repo-network-websocket": "2.6.0-alpha.2",
    "@lararium/mempalace": "workspace:*",
    "@lararium/mesh": "workspace:*",
    "@lararium/node": "workspace:*",
    "@lararium/tw5": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "vitest": "^3.2.0"
  }
}
