{
  "name": "@lares/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Lares operator CLI \u2014 lares init, lares act (Residency Model ACTION verbs), lares wiki, lares bag, lares heleuma, \u2026 One entry point for every operator-facing ceremony.",
  "type": "module",
  "bin": {
    "lares": "./bin/lares.mjs"
  },
  "scripts": {
    "prebuild": "node ../../tools/clean-output.mjs dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/bin/lares.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@automerge/automerge-repo": "^2.5.5",
    "@automerge/automerge-repo-network-websocket": "^2.5.5",
    "@lararium/mesh": "workspace:*",
    "@lararium/node": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
